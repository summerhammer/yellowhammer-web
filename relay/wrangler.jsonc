{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yellowhammer-relay",
	"main": "src/index.tsx",
	// Pinned to the newest date @cloudflare/vitest-pool-workers@0.22.0's bundled workerd (via
	// miniflare@5.20260815.0-alpha) supports. Bumping this ahead of that pin breaks `pnpm test`
	// with "newest date supported by this server binary is ...". Bump only after the pool
	// package's bundled miniflare/workerd catches up.
	"compatibility_date": "2026-08-22",
	"assets": {
		"directory": "./public"
	},
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "df0447e28aea4bf1a77f22561821097e"
		}
	],
	// Per-IP cap on session creation to protect the KV daily write quota. Counters are
	// per Cloudflare location, so this is approximate, not a global cap.
	"ratelimits": [
		{
			"name": "SESSION_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"routes": [
		{
			"pattern": "app.yellowhammer.dev",
			"custom_domain": true
		}
	]
}
