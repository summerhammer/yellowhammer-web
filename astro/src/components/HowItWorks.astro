---
import { steps } from "../content/steps";
import Section from "./Section.astro";
---

<Section
	id="how-it-works"
	eyebrow="How it works"
	title="How a Night runs"
	intro="A Night is one overnight run for one of your products, from the first step to the morning report. Yellowhammer selects work from your specification, runs your coding agents, and leaves an honest verdict on your board by morning."
>
	<ol class="steps">
		{
			steps.map((step) => (
				<li class="step">
					<p class="step-act">{step.label}</p>
					<h3>{step.title}</h3>
					<p>{step.body}</p>
				</li>
			))
		}
	</ol>
</Section>
