---
import { links, requires } from "../content/site";
import DownloadIcon from "./DownloadIcon.astro";

/*
 * The colour scheme switcher is three radios and CSS only (see global.css, "Colour scheme").
 * Without JavaScript the choice is not remembered across reloads; System is the default.
 */
const schemes = [
	{ id: "scheme-system", label: "System" },
	{ id: "scheme-light", label: "Light" },
	{ id: "scheme-dark", label: "Dark" },
];
---

<footer class="pt-[clamp(4rem,9vw,7rem)] pb-10">
	<div class="page-inner">
		<div class="glow-corner card flex flex-col items-start gap-6 overflow-hidden sm:p-12">
			<img src="/yellowhammer-mark.svg" alt="" width="48" height="48" class="size-12" />
			<h2 class="max-w-[20ch] text-3xl leading-[1.1] font-bold tracking-[-0.02em] text-balance sm:text-5xl">
				Every Night ends with a verdict, even the empty ones.
			</h2>
			<p class="max-w-[56ch] text-lg leading-relaxed text-ink-muted">
				Go to bed with a specification. Wake up to pull requests, and a Night Summary on your board that says what
				landed, what is blocked and what needs you.
			</p>
			<div>
				<div class="flex flex-wrap items-center gap-3">
					<a href={links.download} class="btn btn-primary">
						<DownloadIcon />
						Download for Mac
					</a>
					<a href={links.repo} class="btn btn-ghost">View on GitHub</a>
				</div>
				<p class="mt-3 text-sm text-ink-muted">{requires}</p>
			</div>
		</div>

		<div
			class="mt-10 flex flex-col gap-6 border-t border-hairline pt-8 text-sm text-ink-muted md:flex-row md:items-center md:justify-between"
		>
			<div class="flex flex-col gap-3">
				<nav aria-label="Footer">
					<ul class="flex flex-wrap gap-x-5 gap-y-2">
						<li><a href={links.docs}>Docs</a></li>
						<li><a href={links.repo}>GitHub</a></li>
						<li><a href={links.download}>Download</a></li>
					</ul>
				</nav>
				<p>
					Yellowhammer is open source under the MIT licence.{" "}
					<a href={links.repo}>Read the source on GitHub</a>.
				</p>
				<p>© Summer Hammer, LLC</p>
			</div>

			<fieldset class="scheme self-start md:self-auto">
				<legend class="sr-only">Colour scheme</legend>
				{
					schemes.map((scheme, index) => (
						<>
							<input
								class="scheme-input sr-only"
								type="radio"
								name="scheme"
								id={scheme.id}
								checked={index === 0}
							/>
							<label class="scheme-label" for={scheme.id}>
								{scheme.label}
							</label>
						</>
					))
				}
			</fieldset>
		</div>
	</div>
</footer>
