---
import { links, requirement, trustLine } from "../content/site";

/**
 * The colour scheme switcher. CSS only: global.css re-keys the tokens with
 * :root:has(#scheme-light:checked) and :root:has(#scheme-dark:checked). Without JavaScript the
 * choice is not remembered across reloads, so System is the checked default.
 */
const schemes = [
	{ id: "scheme-system", label: "System" },
	{ id: "scheme-light", label: "Light" },
	{ id: "scheme-dark", label: "Dark" },
];
---

<footer class="border-t border-rule">
	<div class="grid lg:grid-cols-12">
		<div class="px-4 pt-16 pb-12 sm:px-8 lg:col-span-7 lg:pt-24">
			<p class="ledger-label">Colophon</p>
			<p class="mt-4 max-w-[20ch] text-3xl leading-tight font-bold tracking-tight text-balance sm:text-4xl">
				Go to bed with a specification. Wake up with <span class="highlight">pull requests</span>.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a href={links.download} class="button-primary h-11 px-5 text-base">Download for Mac</a>
				<a href={links.repo} class="button-secondary h-11 px-5 text-base">View on GitHub</a>
			</div>
			<p class="mt-4 text-sm text-ink-muted">
				<span class="font-semibold text-ink">{requirement}.</span>{" "}
				{trustLine}
			</p>
		</div>
		<div
			class="grid content-start gap-10 border-t border-rule px-4 py-12 sm:grid-cols-2 sm:px-8 lg:col-span-5 lg:grid-cols-1 lg:border-t-0 lg:border-l lg:pt-24"
		>
			<nav aria-labelledby="footer-links-heading">
				<h2 id="footer-links-heading" class="ledger-label">Links</h2>
				<ul class="mt-3 border-t border-rule text-[0.9375rem]">
					<li class="border-b border-rule py-2.5">
						<a href={links.download} class="text-link">Download for Mac</a>
					</li>
					<li class="border-b border-rule py-2.5">
						<a href={links.repo} class="text-link">Source on GitHub</a>
					</li>
					<li class="border-b border-rule py-2.5">
						<a href={links.docs} class="text-link">Docs (README)</a>
					</li>
					<li class="border-b border-rule py-2.5">
						<a href={links.licence} class="text-link">MIT licence</a>
					</li>
				</ul>
			</nav>
			<fieldset>
				<legend class="ledger-label">Appearance</legend>
				<div class="mt-3 inline-flex rounded-lg border border-wing p-0.5">
					{
						schemes.map((scheme, index) => (
							<label class="cursor-pointer rounded-md px-3 py-1.5 text-sm text-ink-muted hover:text-ink has-checked:bg-ink has-checked:font-semibold has-checked:text-paper has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-focus">
								<input
									type="radio"
									name="scheme"
									id={scheme.id}
									value={scheme.label.toLowerCase()}
									checked={index === 0}
									class="sr-only"
								/>
								{scheme.label}
							</label>
						))
					}
				</div>
				<p class="mt-3 text-sm text-ink-muted">System follows your Mac's appearance.</p>
			</fieldset>
		</div>
	</div>
	<div
		class="flex flex-col gap-2 border-t border-rule px-4 py-6 text-sm text-ink-muted sm:flex-row sm:justify-between sm:px-8"
	>
		<p>
			Yellowhammer is open source under the{" "}
			<a href={links.licence} class="text-link">MIT licence</a>.
		</p>
		<p>© Summer Hammer, LLC</p>
	</div>
</footer>
