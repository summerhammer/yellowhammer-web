---
import { links } from "../content/site";
---

<header
	class="sticky top-0 z-40 border-b border-rule bg-paper-veil backdrop-blur-md backdrop-saturate-150"
>
	<nav
		aria-label="Primary"
		class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:gap-6 sm:px-8"
	>
		<a href="/" class="-ml-1 flex shrink-0 items-center gap-2 rounded-sm px-1">
			<img src="/yellowhammer-mark.svg" alt="" width="24" height="24" class="size-6" />
			<span class="text-[0.9375rem] font-bold tracking-tight">Yellowhammer</span>
		</a>
		<a
			href={links.docs}
			class="hidden text-sm text-ink-muted hover:text-ink min-[400px]:inline">Docs</a
		>
		<span class="flex-1" aria-hidden="true"></span>
		<a href={links.repo} class="text-sm text-ink-muted hover:text-ink">GitHub</a>
		<a href={links.download} class="button-primary h-9 px-3 text-sm sm:px-4">
			<span class="sm:hidden">Download</span>
			<span class="hidden sm:inline">Download for Mac</span>
		</a>
	</nav>
</header>
