---
import { never, path, terms } from "../content/bento";
import Section from "./Section.astro";
---

<Section
	id="what-it-does"
	eyebrow="What it does"
	heading="It judges the work. Your agents write it."
	intro="Each Night, Yellowhammer picks one Feature, sends every Work Card to an agent CLI, verifies the result against a Definition of Done written before any code, and reports back to your board. You read the result in the morning."
>
	<div class="bento">
		<article class="card glow-corner bento-large flex flex-col justify-between gap-10">
			<p class="eyebrow">Never, by design</p>
			<div>
				<h3 class="max-w-[22ch] text-3xl leading-[1.12] font-bold tracking-[-0.02em] text-balance sm:text-4xl">
					{never.title}
				</h3>
				<p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-ink-muted">{never.body}</p>
			</div>
		</article>
		{
			terms.map((term) => (
				<article class="card card-quiet bento-small">
					<p class="term">Glossary</p>
					<h3 class="mt-2 text-lg font-semibold tracking-tight">{term.title}</h3>
					<p class="mt-2 leading-relaxed text-ink-muted">{term.body}</p>
				</article>
			))
		}
		{
			path.map((card, index) => (
				<article class="card bento-medium">
					<p class="step-number">
						<span class="sr-only">Step </span>
						{String(index + 1).padStart(2, "0")}
						<span class="sr-only"> of {path.length}</span>
					</p>
					<h3 class="mt-3 text-xl font-semibold tracking-tight">{card.title}</h3>
					<p class="mt-2 leading-relaxed text-ink-muted">{card.body}</p>
				</article>
			))
		}
	</div>
</Section>
