---
import { site } from "../content/site";

interface Props {
	size?: "sm" | "md";
	label?: string;
}

const { size = "md", label = "Download for Mac" } = Astro.props;
---

<a class:list={["btn btn-download", { "btn-sm": size === "sm" }]} href={site.download}>
	<svg class="btn-glyph" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
		<path d="M8 2v8M5 7l3 3 3-3M2.5 10v2a1.5 1.5 0 0 0 1.5 1.5h8a1.5 1.5 0 0 0 1.5-1.5v-2"></path>
	</svg>
	{label}
</a>
