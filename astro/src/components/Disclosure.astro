---
interface Props {
	summary: string;
}

const { summary } = Astro.props;
---

<details class="disclosure rounded-xl border border-line bg-tint">
	<summary class="flex min-h-11 items-center justify-between gap-4 px-4 py-2.5 text-base font-semibold">
		<span>{summary}</span>
	</summary>
	<div class="space-y-3 px-4 pb-4 text-base leading-relaxed text-ink">
		<slot />
	</div>
</details>
