---
/*
 * "The night edition": a static 07:00 frame of the Anatomy figure in figures/plant.
 * The SVG is inlined at build time so the page stylesheet themes it through the --anatomy-* tokens
 * (src/styles/figure-theme.css). Plate markup follows figures/src/iso/iso-kit.ts.
 */
import keyOne from "../figures/key-1.svg?raw";
import keyTwo from "../figures/key-2.svg?raw";
import nightEdition from "../figures/night-edition.svg?raw";

const keys = [
	{
		svg: keyOne,
		label: "One issue you can follow, from the wire to its bundle",
	},
	{
		svg: keyTwo,
		label: "Story sheets, plates and papers: the other issues of the night",
	},
];
---

<div class="iso">
	<figure class="iso-figure">
		<div class="iso-plate">
			<div class="iso-plate-corners" aria-hidden="true">
				<span class="iso-plate-corner" data-corner="fig">Fig. 1</span>
				<span class="iso-plate-corner" data-corner="title">The night edition</span>
				<span class="iso-plate-corner" data-corner="readout">07:00</span>
			</div>
			<Fragment set:html={nightEdition} />
		</div>
		<figcaption class="iso-legend">
			<span class="iso-keys">
				{
					keys.map((key) => (
						<span class="iso-key">
							<Fragment set:html={key.svg} />
							{key.label}{" "}
						</span>
					))
				}
			</span>{" "}
			<span class="iso-caption">
				The night edition, at 07:00. Linear issues come off the wire in the evening as story sheets and
				wait on the spike. From 22:00 the typesetter, the agent in Orca, takes one Work Card at a time
				and composes it line by line. The plate goes to the press, which runs the build and tests on the
				build tick every 15 minutes. Every print goes up to the proof desk for a Round of review and
				checks. A proof that fails goes back down the return chute, is reworked and printed again. One
				that passes is stamped and dropped to the dock, where the papers of each Repo Lane are tied into
				one bundle on the land tick: one pull request each.
			</span>{" "}
			<span class="iso-caption iso-note">
				The figure's own example: 8 issues go in at night, 3 come back once, and by morning 6 pull
				requests wait on the dock for your review. These are not product measurements.
			</span>
		</figcaption>
	</figure>
</div>
