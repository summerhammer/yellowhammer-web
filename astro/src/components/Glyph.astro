---
// Small status glyphs. They always sit beside a text label, so colour is never the only signal.
interface Props {
	name: "night" | "landed" | "waiting" | "blocked" | "never" | "check";
	class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	class={className}
>
	{name === "night" && <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />}
	{
		name === "landed" && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path d="M8 12.5l2.7 2.7L16 9.5" />
			</>
		)
	}
	{
		name === "waiting" && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path d="M9.6 9.6a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1.1.9-1.1 1.7" />
				<path d="M12 16.8h.01" />
			</>
		)
	}
	{
		name === "blocked" && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path d="M7.5 12h9" />
			</>
		)
	}
	{
		name === "never" && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path d="M5.6 5.6l12.8 12.8" />
			</>
		)
	}
	{name === "check" && <path d="M5 12.5l4.5 4.5L19 7.5" />}
</svg>
