---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, getPublishedPosts, postPath } from "../../lib/blog";
import "../../styles/blog.css";

const posts = await getPublishedPosts();
---
<Layout title="Blog — Yellowhammer" description="Notes on unattended engineering, specifications, and building Yellowhammer.">
 <Header />
 <main id="main" class="wrap blog-main">
  <div class="blog-heading"><h1>Blog</h1><p>Notes on unattended engineering, specifications, and building Yellowhammer.</p><a href="/blog/rss.xml">Subscribe via RSS <span aria-hidden="true">↗</span></a></div>
  {posts.length ? <ul class="post-list">{posts.map(({ id, data }) => <li class="post-row">
   <div class="post-meta"><time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time><span>{data.author}</span></div>
   <div><h2><a href={postPath(id)}>{data.title}</a></h2><p>{data.description}</p>{data.tags.length > 0 && <ul class="post-tags" aria-label="Tags">{data.tags.map(tag => <li>{tag}</li>)}</ul>}</div>
  </li>)}</ul> : <div class="blog-empty"><h2>The first post is on its way.</h2><p>Until then, explore how Yellowhammer turns your specification into overnight engineering work.</p><a href="/docs">Read the documentation <span aria-hidden="true">→</span></a></div>}
 </main>
 <Footer compact />
</Layout>
