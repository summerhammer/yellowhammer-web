---
import { type CollectionEntry, render } from "astro:content";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, getPublishedPosts } from "../../lib/blog";
import "../../styles/blog.css";
export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props {
	post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
---
<Layout title={`${data.title} — Yellowhammer`} description={data.description} cover={data.cover} article={{ author: data.author, published: data.pubDate, updated: data.updatedDate }}>
 <Header />
 <main id="main" class="wrap blog-main">
  <article class="blog-article">
   <a class="back-link" href="/blog">← All posts</a>
   <header class="article-heading"><h1>{data.title}</h1><p class="article-description">{data.description}</p><div class="post-meta"><span>{data.author}</span><time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>{data.updatedDate && <span>Updated <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></span>}</div>{data.tags.length > 0 && <ul class="post-tags" aria-label="Tags">{data.tags.map(tag => <li>{tag}</li>)}</ul>}</header>
   {data.cover && <img class="article-cover" src={data.cover.src} alt={data.cover.alt} />}
   <div class="article-prose"><Content /></div>
   <a class="back-link article-back" href="/blog">← All posts</a>
  </article>
 </main>
 <Footer compact />
</Layout>
