---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import NeverBand from "../components/NeverBand.astro";
import NightTimeline from "../components/NightTimeline.astro";
import Questions from "../components/Questions.astro";
import Tools from "../components/Tools.astro";
import WorksWith from "../components/WorksWith.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Yellowhammer: wake up to pull requests for work nobody wrote down"
	description="Yellowhammer picks the next Feature from your specification each Night, runs your own coding agents on it, and leaves one pull request per repository and an honest report on your Linear board by morning."
>
	<Header />
	<main id="main">
		<Hero />
		<WorksWith />
		<NightTimeline />
		<NeverBand />
		<Tools />
		<Questions />
	</main>
	<Footer />
</Layout>
