---
import DoesNever from "../components/DoesNever.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Showcase from "../components/Showcase.astro";
import Tools from "../components/Tools.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Yellowhammer: wake up to pull requests"
	description="Yellowhammer is a Mac app that runs an unattended engineering Shift every Night, on top of Orca ADE, Linear and the agent CLIs you already use."
>
	<Header />
	<div class="mx-auto max-w-6xl border-x border-rule">
		<main id="main">
			<Hero />
			<Showcase />
			<DoesNever />
			<Tools />
			<HowItWorks />
		</main>
		<Footer />
	</div>
</Layout>
