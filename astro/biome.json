{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": [
			"**",
			"!src/styles/vendor/anatomy-kit.css",
			"!src/figures/night-edition.svg"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["public/**/*.svg", "src/figures/**/*.svg"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		}
	]
}
